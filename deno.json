{
  "tasks": {
    "test": "deno test --allow-env=GOVERNOR_CONFIG --allow-read=install.sh,rules,test/fixtures,test/.tmp --allow-write=test/.tmp --allow-run test/",
    "rules:check": "deno run --allow-net=www.hostinger.com --allow-read=rules tools/rules-watch.ts check",
    "rules:accept": "deno run --allow-net=www.hostinger.com --allow-read=rules --allow-write=rules tools/rules-watch.ts accept",
    "sim": "deno run --allow-env=GOVERNOR_CONFIG test/sim.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts && deno task test && bash -n install.sh test/smoke-linux.sh tools/compile.sh tools/rules-heartbeat.sh tools/setup-hostinger-broker.sh",
    "compile:jitless": "bash tools/compile.sh jitless",
    "compile:jit-fixture": "bash tools/compile.sh jit-fixture",
    "compile": "deno task compile:jitless",
    "smoke:linux": "bash test/smoke-linux.sh"
  },
  "fmt": { "lineWidth": 100 },
  "imports": { "@std/assert": "jsr:@std/assert@^1.0.14" }
}
