{
  "tasks": {
    "test": "deno test --allow-env=GOVERNOR_CONFIG --allow-read=install.sh,rules,test/fixtures,test/.tmp --allow-write=test/.tmp --allow-run test/",
    "rules:check": "deno run --allow-net=www.hostinger.com --allow-read=rules tools/rules-watch.ts check",
    "rules:accept": "deno run --allow-net=www.hostinger.com --allow-read=rules --allow-write=rules tools/rules-watch.ts accept",
    "sim": "deno run --allow-env=GOVERNOR_CONFIG --allow-read=test/.tmp --allow-write=test/.tmp test/sim.ts",
    "sim:check": "deno run --allow-env=GOVERNOR_CONFIG --allow-read=test/.tmp,docs/calibration-results.json --allow-write=test/.tmp test/sim.ts --calibration --check",
    "sim:record": "deno run --allow-env=GOVERNOR_CONFIG --allow-read=test/.tmp --allow-write=test/.tmp,docs/calibration-results.json test/sim.ts --calibration --record",
    "sim:jumps": "deno run --allow-env=GOVERNOR_CONFIG --allow-read=src,test --allow-write=test/.tmp test/jump-study.ts",
    "sim:legacy": "deno run --allow-env=GOVERNOR_CONFIG --allow-read=test/fixtures test/sim.ts --legacy-check",
    "sim:legacy-record": "deno run --allow-env=GOVERNOR_CONFIG --allow-read=test/fixtures --allow-write=test/fixtures/legacy-off.json test/sim.ts --legacy-record",
    "bench:cpu": "deno run --v8-flags=--jitless --allow-env=GOVERNOR_CONFIG --allow-read=test/.tmp --allow-write=test/.tmp test/daemon-cpu.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts tools/compile.ts tools/diagram-curves.ts tools/rules-watch.ts test/jump-study.ts test/daemon-cpu.ts && deno task test && bash -n install.sh test/smoke-linux.sh tools/rules-heartbeat.sh tools/setup-hostinger-broker.sh",
    "compile:jitless": "deno run --allow-run tools/compile.ts jitless",
    "compile:jit-fixture": "deno run --allow-run tools/compile.ts jit-fixture",
    "compile": "deno task compile:jitless",
    "smoke:linux": "bash test/smoke-linux.sh"
  },
  "fmt": { "lineWidth": 100 },
  "imports": { "@std/assert": "jsr:@std/assert@^1.0.14" }
}
