#!/usr/bin/env bash
# An example hook. The governor runs every executable in /etc/governor/hooks.d as the governor user,
# with GOVERNOR_EVENT naming limit-start, limit-end, limit-classified, calibration,
# rules-mismatch or readings-invalid, and its public state as JSON on stdin.
# Use one to tell your people or pause your own work; it has 60 seconds.
set -euo pipefail
state=$(cat)
percent=$(printf '%s' "$state" | sed -n 's/.*"percent":\([0-9]*\).*/\1/p')
logger -t governor-hook "$GOVERNOR_EVENT (credits ${percent:-?}%)"
